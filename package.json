{
  "name": "eclipse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-push.mjs && npm run i18n:extract && node --import tsx scripts/i18n-warm.mjs && next build",
    "db:push": "prisma db push",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "i18n:extract": "node --import tsx scripts/i18n-extract.mjs",
    "i18n:warm": "I18N_BUILD_WARM=on node --import tsx scripts/i18n-warm.mjs",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-storage": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@clerk/nextjs": "6.39.7",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/client": "^5.22.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.0.0",
    "@vercel/sandbox": "3.8.0",
    "@whop/sdk": "2.1.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.51.0",
    "mammoth": "1.13.0",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.5",
    "simple-icons": "^13.21.0",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
