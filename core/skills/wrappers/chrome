#!/bin/sh
# Eclipse wrapper (not part of the vendored skill): the skill's inspect.mjs launches the browser named by CHROME_PATH and cannot pass
# flags. Inside a build machine the machine itself is the security boundary, and Chromium refuses to run as root without --no-sandbox.
for c in "$SANDBOX_CHROME" /usr/bin/chromium /usr/bin/chromium-browser /usr/bin/google-chrome /usr/bin/google-chrome-stable /opt/pw-browsers/chromium-*/chrome-linux/chrome; do
  [ -n "$c" ] && [ -x "$c" ] && exec "$c" --no-sandbox --disable-gpu --disable-dev-shm-usage "$@"
done
echo "No Chromium found on this build machine" >&2
exit 127
