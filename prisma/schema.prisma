generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users live in Clerk; userId is the Clerk user id.
model Generation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  prompt    String
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("generations")
}

// One row per user, written when they finish onboarding right after signing up.
model Onboarding {
  userId      String   @id @map("user_id")
  usage       String
  experience  String
  audience    String
  contentType String   @map("content_type")
  source      String
  blocker     String[] // multiple challenges can be chosen
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("onboarding")
}
