# Postgres (Neon). DATABASE_URL is the pooled string the app uses; DIRECT_URL is the direct (unpooled) one Prisma uses to apply the schema.
# On Vercel the build applies prisma/schema.prisma automatically (scripts/db-push.mjs) when DIRECT_URL is set.
DATABASE_URL=
DIRECT_URL=

# Clerk (set these in Vercel > Settings > Environment Variables, Preview scope first, then redeploy; never commit real keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Storage: Cloudflare R2 bucket (private). The token needs Object Read and Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Payments: Whop (behind src/lib/payments). One plan id per plan in src/lib/plans.ts.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# WHOP_COMPANY_ID=
WHOP_PLAN_STARTER=
WHOP_PLAN_GROWTH=
WHOP_PLAN_SCALE=
# WHOP_API_BASE=https://api.whop.com/api/v1

# Higgsfield
HIGGSFIELD_API_KEY=
# Optional overrides (see src/lib/higgsfield.ts)
# HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
# HIGGSFIELD_MODEL=higgsfield-ai/soul/standard
